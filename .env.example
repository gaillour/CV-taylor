# ==============================================================================
# CV Tailor Backend Environment Variables
# ==============================================================================

# Server binding (Railway/Render/Fly injects PORT automatically)
PORT=8000

# CORS Configuration
# Comma-separated list of allowed origins, e.g. https://my-app.vercel.app,https://custom-domain.com
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
# Optional custom regex to match preview domains
# CORS_ORIGIN_REGEX=^(https?://(localhost|127\.0\.0\.1)(:\d+)?|https://.*\.vercel\.app)$

# Supabase Cloud Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# Or standard alias:
# SUPABASE_KEY=your-supabase-key

# LLM Providers (Configure at least one for tailoring, distillation & translation)
GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# OLLAMA_BASE_URL=
